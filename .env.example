# Copy this file to .env and replace the placeholders.
# The .env file is read by systemd (see piguard.service) and must not be committed.

TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_CHAT_ID=replace-with-chat-id

# Optional. Defaults to /var/log/suricata/eve.json when unset.
# SURICATA_EVE_PATH=/var/log/suricata/eve.json
