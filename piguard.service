[Unit]
Description=Pi Guard Telegram Bot
After=network-online.target suricata.service
Wants=network-online.target

[Service]
User=user
WorkingDirectory=/home/user/pi_guard_bot
EnvironmentFile=/home/user/pi_guard_bot/.env
ExecStart=/usr/bin/python3 /home/user/pi_guard_bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
